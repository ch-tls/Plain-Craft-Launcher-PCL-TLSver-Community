<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WindowServerFileEditor"
    Title="服务器文件浏览与编辑"
    Height="720" Width="1080" MinHeight="420" MinWidth="760"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Background="#F2F5FA" Foreground="#103A75"
    FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#DCE6F5" />
            <Setter Property="Foreground" Value="#103A75" />
            <Setter Property="BorderBrush" Value="#B9CDE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C7D8F0" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B3C9E8" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M0,0 L5,4 L0,8 Z" Fill="#34558C"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FileTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="False" />
            <Setter Property="Foreground" Value="#103A75" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander" Style="{StaticResource ExpanderToggle}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Margin="14,0,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0FB" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E4FA" />
                                <Setter Property="Foreground" Value="#08295E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#EEF3FA" BorderBrush="#C9D6E8" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabTitle" VerticalAlignment="Center" Foreground="#0B2F6B"
                           FontWeight="SemiBold" FontSize="13"
                           TextTrimming="CharacterEllipsis" Text="未选择文件" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSave" Content="保存 (Ctrl+S)" Style="{StaticResource ToolButton}" />
                    <Button x:Name="BtnReload" Content="重新载入" Style="{StaticResource ToolButton}" />
                    <Button x:Name="BtnRefreshTree" Content="刷新列表" Style="{StaticResource ToolButton}" />
                    <Button x:Name="BtnOpenFolder" Content="打开目录" Style="{StaticResource ToolButton}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <TreeView x:Name="TreeFiles" Grid.Column="0" Background="#F7F9FC" BorderThickness="0"
                      Foreground="#103A75" Padding="4,6" ItemContainerStyle="{StaticResource FileTreeItem}"
                      SelectedItemChanged="TreeFiles_SelectedItemChanged"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <Rectangle Grid.Column="1" Fill="#C9D6E8" />
            <RichTextBox x:Name="Editor" Grid.Column="2" Background="#1E1E1E" Foreground="#D4D4D4"
                         BorderThickness="0" Margin="0" Padding="10,8"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AcceptsReturn="True" AcceptsTab="True" IsUndoEnabled="True"
                         SpellCheck.IsEnabled="False"
                         PreviewKeyDown="Editor_PreviewKeyDown" />
        </Grid>
        <Border Grid.Row="2" Background="#EEF3FA" BorderBrush="#C9D6E8" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="LabStatus" VerticalAlignment="Center" Foreground="#103A75" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                <TextBlock x:Name="LabStatusRight" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="#103A75" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
